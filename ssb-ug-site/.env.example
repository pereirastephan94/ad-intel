# Storyblok — leave empty to render the bundled local content in content/
STORYBLOK_PREVIEW_TOKEN=
# "draft" while editing, "published" in production
STORYBLOK_VERSION=published
# Storyblok region: eu | us | ap | ca | cn
STORYBLOK_REGION=eu

# Used only by `npm run storyblok:push` (Management API). Never commit real values.
STORYBLOK_PERSONAL_ACCESS_TOKEN=
STORYBLOK_SPACE_ID=

# Where waitlist / brochure sign-ups are forwarded (e.g. a Google Apps Script or CRM webhook)
LEAD_WEBHOOK_URL=
