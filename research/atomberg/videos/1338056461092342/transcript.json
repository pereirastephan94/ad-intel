    "text": "وہ ہی تکش کر پائے"
   },
   {
    "start": 13.4,
    "end": 16.6,
    "text": "سلمتے کہای ہو پائے گھر پے"
   },
   {
    "start": 16.8,
    "end": 19.8,
    "text": "آنے دو ممیجی کو اب دو کیوں کی"
   },
   {
    "start": 19.8,
    "end": 24.3,
    "text": "چاپر جار بھیس میں سمائے"
   },
   {
    "start": 24.9,
    "end": 30.1,
    "text": "ممیجی کی سے وقر نے کو جو اتنے پاپڑ بھیلے"
   },
   {
    "start": 30.1,
    "end": 31.5,
    "text": "پر جاغوں گی"
   },
   {
    "start": 31.5,
    "end": 35.7,
    "text": "اب یہی پے گھر تمارے گھر وہ بولے"
   },
   {
    "start": 35.7,
    "end": 37.9,
    "text": "دے دے انکے گھر کے لیے"
   },
   {
    "start": 37.9,
    "end": 43.3,
    "text": "بھی میکسر لگیف سے کہ رہ پر میں مندو آکے رے"
