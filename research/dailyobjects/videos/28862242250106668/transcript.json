 "transcript": {
  "language": "hi",
  "text": "ہم انستان میں پیدا ہوئے, آگے کھولی انستان میں, انستان کوئی دیکھا, جو گرو لوگ تھے, وہ سب انستانی ہیں, ہوں کو کرتے ہوئی دیکھا, تو اسی کانوصراں ہم نے کر لیا. بکانتی, دن پیرویزیان ایسٹوری, ہمیں پتہ نہیں ہوتا تھا کسیکڑ اور دبے ہوتا تھے, ہندی میں اوردوں میں لگ دیا کرتے تھے, سامانگنا, وہ مجھے یہگنم اگنم اگنم مولے گیا, وہ دو چلکنے وہی کاہیل. سب سے بڑے چیز پیاری, مادھے میں, میڈیہ میں پیار, میں سونستان کے پیار سے ہی دنیا چندھی ہے. یہ ہمہرے مانکہ کاماں پنے کرا دیا. ہمیں تو پرمائیس کرنے کا شاک بے سے بھی ہے. پوسیس کرتے فارمائیس طوری کیا.",
  "segments": [
   {
    "start": 0,
    "end": 4.1,
    "text": "ہم انستان میں پیدا ہوئے, آگے کھولی انستان میں,"
   },
   {
    "start": 4.1,
    "end": 7.9,
    "text": "انستان کوئی دیکھا, جو گرو لوگ تھے,"
   },
   {
    "start": 7.9,
    "end": 9.5,
    "text": "وہ سب انستانی ہیں,"
   },
   {
    "start": 9.5,
    "end": 11.2,
    "text": "ہوں کو کرتے ہوئی دیکھا,"
   },
   {
    "start": 12.3,
    "end": 14.3,
    "text": "تو اسی کانوصراں ہم نے کر لیا."
   },
   {
    "start": 23.7,
    "end": 25.9,
    "text": "بکانتی, دن پیرویزیان ایسٹوری,"
   },
   {
    "start": 25.9,
    "end": 29.3,
    "text": "ہمیں پتہ نہیں ہوتا تھا کسیکڑ اور دبے ہوتا تھے,"
   },
   {
    "start": 29.6,
    "end": 31.8,
    "text": "ہندی میں اوردوں میں لگ دیا کرتے تھے,"
   },
   {
    "start": 31.8,
    "end": 32.8,
    "text": "سامانگنا,"
   },
   {
    "start": 32.8,
    "end": 36,
    "text": "وہ مجھے یہگنم اگنم اگنم مولے گیا,"
   },
   {
    "start": 36,
    "end": 38,
    "text": "وہ دو چلکنے وہی کاہیل."
   },
   {
    "start": 41.9,
    "end": 43.4,
    "text": "سب سے بڑے چیز پیاری,"
   },
   {
    "start": 43.4,
    "end": 44.7,
    "text": "مادھے میں,"
   },
   {
    "start": 44.7,
    "end": 45.8,
    "text": "میڈیہ میں پیار,"
   },
   {
    "start": 45.8,
    "end": 49,
    "text": "میں سونستان کے پیار سے ہی دنیا چندھی ہے."
   },
   {
    "start": 49.8,
    "end": 52,
    "text": "یہ ہمہرے مانکہ کاماں پنے کرا دیا."
   },
   {
    "start": 53,
    "end": 56.6,
    "text": "ہمیں تو پرمائیس کرنے کا شاک بے سے بھی ہے."
   },
   {
    "start": 56.6,
    "end": 60.1,
    "text": "پوسیس کرتے فارمائیس طوری کیا."
   }
  ]
 }
}